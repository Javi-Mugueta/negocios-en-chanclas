# Nombres de las variables. Sin valores.
# Producción y vista previa las tienen configuradas en el alojamiento.
# En local, cópialas a .env.local.

NEC_DATABASE_URL=
NEC_SESSION_SECRET=
NEC_ADMIN_USER=
NEC_ADMIN_PASSWORD_HASH=
NEC_IP_SALT=
# Opcional: fecha ISO (hora de Madrid si no lleva zona) hasta la que /formularios-llc
# queda oculta. Vacía = siempre visible.
NEC_FORMULARIOS_LAUNCH=
